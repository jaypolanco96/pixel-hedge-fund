# BloFin LIVE trading (copy from C:\Users\jorda\.grokbot\blofin.env on Windows)
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=
# Default is LIVE production. Demo is opt-in only (discouraged):
# BLOFIN_BASE_URL=https://demo-trading-openapi.blofin.com
BLOFIN_BASE_URL=https://openapi.blofin.com

# Bybit (optional — or save via Desk LOGIN tab → .secrets/exchanges.json)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BYBIT_PASSPHRASE=
BYBIT_BASE_URL=https://api.bybit.com
