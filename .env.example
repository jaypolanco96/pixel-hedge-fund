# Optional for SOLO local dev only.
# On Vercel (multi-visitor): do NOT set TRADE secrets — visitors use Desk LOGIN
# (sessionStorage → per-request x-phf-* headers). See BLOFIN.md.

# BloFin LIVE trading
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=
# Default is LIVE production. Demo is opt-in only (discouraged):
# BLOFIN_BASE_URL=https://demo-trading-openapi.blofin.com
BLOFIN_BASE_URL=https://openapi.blofin.com

# Bybit (optional — or Desk LOGIN)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BYBIT_PASSPHRASE=
BYBIT_BASE_URL=https://api.bybit.com
