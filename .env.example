# Optional for SOLO local dev only.
# On Vercel (multi-visitor): do NOT set TRADE secrets — visitors use Desk LOGIN
# (sessionStorage → per-request x-phf-* headers). See BLOFIN.md.

# BloFin LIVE trading
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=
# Required when the BloFin API key is bound to a broker application.
BLOFIN_BROKER_ID=
# Default is LIVE production. Demo is opt-in only (discouraged):
# BLOFIN_BASE_URL=https://demo-trading-openapi.blofin.com
BLOFIN_BASE_URL=https://openapi.blofin.com

# Bybit (optional — or Desk LOGIN)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Required when the Bybit API key is broker-bound.
BYBIT_BROKER_ID=
# BYBIT_PASSPHRASE=
BYBIT_BASE_URL=https://api.bybit.com

# Local `npm run dev` uses labeled SAMPLE fallbacks by default when exchanges are unreachable.
# Set this to true locally to require live data while testing. Production is always live-only.
PHF_LIVE_ONLY=
